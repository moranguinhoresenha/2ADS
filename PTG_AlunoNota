programa { 
  funcao inicio() { 
    
    // var
    inteiro q, i, ap = 0 
    real n1, n2, md 
        
    // dados
    escreva("Informe quantos alunos serão cadastrados: ") 
    leia(q) 
        
    para(i = 1; i <= q; i++) {
      escreva("\nAluno ", i, ":\n")
      escreva("Informe a primeira nota: ")
      leia(n1)
            
      escreva("Informe a segunda nota: ")
      leia(n2)
            
      // calc
      md = (n1 + n2) / 2
      escreva("Média do aluno ", i, ": ", md, "\n")
            
      se(md >= 7.0) {
         ap = ap + 1
        }
     }
    // res
    escreva("\nTotal de alunos aprovados: ", ap)
  } 
}
